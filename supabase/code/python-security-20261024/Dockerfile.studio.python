FROM node@sha256:de170b39439eb0e5a3444ad7d60b015614a381e10fecae2e30ec9e735122f38d AS runtime
FROM supabase/studio@sha256:a2ebda20912b136707a99729ce8bf8f8d5ad240094f43e0fe914937f94ffdf68
COPY --from=runtime /usr/local/bin/node /usr/local/bin/node
ENV NODE_VERSION=22.23.4
RUN node -e "if(process.version!=='v22.23.4')process.exit(1);console.log(process.version)"
LABEL trafficlion.maintenance="supabase-node-20261024"

RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --only-upgrade --no-install-recommends python3.11=3.11.2-6+deb12u9 python3.11-minimal=3.11.2-6+deb12u9 libpython3.11-minimal=3.11.2-6+deb12u9 libpython3.11-stdlib=3.11.2-6+deb12u9 ca-certificates=20250419~deb12u2 libssl3=3.0.22-1~deb12u1 openssl=3.0.22-1~deb12u1 libexpat1 libsqlite3-0 zlib1g liblzma5 && rm -rf /var/lib/apt/lists/*
RUN test "$(dpkg-query -W -f='${Version}' python3.11)" = "3.11.2-6+deb12u9" && node -e "if(process.version!=='v22.23.4')process.exit(1)"
LABEL trafficlion.python-maintenance="20261024-debian-backports"

COPY patch-python-security.py /usr/local/share/trafficlion/patch-python-security.py
RUN node -e "const fs=require('fs'),crypto=require('crypto');fetch('https://files.pythonhosted.org/packages/3f/06/3e4420302363fbb71be3c7f35ce042f54bfca330e3e66b3a2e3c4cca579f/pip-26.2.2-py3-none-any.whl').then(async r=>{if(!r.ok)throw Error('pip download failed');const b=Buffer.from(await r.arrayBuffer());if(crypto.createHash('sha256').update(b).digest('hex')!=='fd7f4dfa8190e014013b9f08f3e973f4e4c26ffd179a204895533a7254813a70')throw Error('pip digest mismatch');fs.writeFileSync('/tmp/pip-security.whl',b)}).catch(e=>{console.error(e.message);process.exit(1)})"
RUN python3 /usr/local/share/trafficlion/patch-python-security.py --pip-wheel /tmp/pip-security.whl && rm /tmp/pip-security.whl
