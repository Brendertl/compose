FROM node@sha256:6abbcf5dd6b231da109bcde1181db1d92bf78015ae1a9514d9807c1f857869db AS runtime
FROM supabase/storage-api@sha256:44ab8bb94101ca2914e689d77fa662f68897ef3bb27aa34c3af6c5f2c0c7b6c5
COPY --from=runtime /usr/local/bin/node /usr/local/bin/node
ENV NODE_VERSION=22.23.4
RUN node -e "if(process.version!=='v22.23.4')process.exit(1);console.log(process.version)"
LABEL trafficlion.maintenance="supabase-node-20261024"
RUN node -e "require('fs-xattr');console.log('xattr_native_load_ok')"
